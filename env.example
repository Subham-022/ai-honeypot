# Copy this file to .env in the same folder (project root) and fill in values.
# The backend loads it automatically via python-dotenv (see backend/main.py).

# Optional. If left blank, the Generative Engine automatically falls back to
# a local Faker-based generator, so the whole project still runs end-to-end
# without any API key or billing setup -- good for offline demos.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Host/port the FastAPI honeypot server binds to.
HONEYPOT_HOST=0.0.0.0
HONEYPOT_PORT=8000

# Public URL where the honeypot is reachable. This gets embedded inside
# generated decoys as the canary webhook/callback URL. For local demos,
# http://localhost:8000 is fine. For a real deployment, use your public
# domain / ngrok URL so canary triggers can actually reach back to you.
PUBLIC_BASE_URL=http://localhost:8000

# Simple bearer token protecting the /admin/regenerate/* endpoint.
HONEYPOT_ADMIN_TOKEN=demo-admin-token-change-me

# How long (seconds) a generated decoy is cached before a fresh one (with a
# new canary token) is generated on next request.
DECOY_CACHE_TTL_SECONDS=300
